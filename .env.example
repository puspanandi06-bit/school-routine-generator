# ========================================================
# SMART SCHOOL ROUTINE GENERATOR - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL for production / Neon / Supabase, or SQLite file for local standalone)
# Example PostgreSQL: postgresql://username:password@ep-cold-dust-123456.us-east-2.aws.neon.tech/schooldb?sslmode=require
# Example SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookies and Auth Tokens (Generate a 64+ char random string in production)
JWT_SECRET="smart-school-routine-generator-super-secure-secret-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Frontend API URL (for frontend .env)
# VITE_API_URL="http://localhost:5000/api"
